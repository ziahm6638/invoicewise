{
  "name": "invoicewise",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "packages/email/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "gate": "bun --no-env-file scripts/gate.ts",
    "e2e": "bun --no-env-file scripts/e2e.ts",
    "e2e:sweep": "bun --no-env-file scripts/e2e-sweep.ts",
    "test": "bun --no-env-file scripts/e2e.ts",
    "test:legacy": "bun --no-env-file scripts/verify/release.ts --legacy-tests-only",
    "start:dashboard": "turbo start --filter=@invoicewise/dashboard",
    "start:website": "turbo start --filter=@invoicewise/website",
    "dev:api": "turbo dev --filter=@invoicewise/api",
    "dev:dashboard": "turbo dev --filter=@invoicewise/dashboard",
    "build:dashboard": "turbo build --filter=@invoicewise/dashboard",
    "dev:website": "turbo dev --filter=@invoicewise/website ",
    "verify": "bun --no-env-file scripts/verify/release.ts",
    "verify:security": "bun --no-env-file scripts/verify/release.ts --security-only",
    "verify:migrations": "bun --no-env-file scripts/verify/release.ts --migrations-only",
    "db:generate": "cd packages/db && DATABASE_PRIMARY_URL=\"$(grep ^DATABASE_PRIMARY_URL= ../../.env | cut -d= -f2-)\" bunx drizzle-kit generate",
    "db:migrate": "cd packages/db && bun --env-file=../../.env run migrate",
    "jobs:worker": "cd packages/jobs && bun --env-file=../../.env run worker",
    "jobs:status": "cd packages/jobs && bun --env-file=../../.env run status",
    "jobs:resume-deletions": "cd packages/jobs && bun --env-file=../../.env run resume-deletions",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check && bun run lint:gates",
    "lint:gates": "biome check scripts e2e && bun scripts/check-feature-map.ts && bun scripts/check-paved-path.ts && bun scripts/check-test-locations.ts",
    "typecheck": "turbo typecheck && tsc --noEmit -p scripts/tsconfig.json"
  },
  "packageManager": "bun@1.3.13",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@manypkg/cli": "^0.24.0",
    "playwright-core": "1.63.0",
    "turbo": "2.5.6",
    "typescript": "^5.9.2"
  },
  "manypkg": {
    "ignoredRules": ["EXTERNAL_MISMATCH"]
  },
  "overrides": {
    "axios": "^1.20.0",
    "browserslist": "^4.29.1",
    "defu": "^6.1.7",
    "engine.io": "~6.6.11",
    "fast-uri": "^3.1.8",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.2",
    "jws": "^4.0.1",
    "linkify-it": "^5.0.2",
    "lodash": "^4.18.1",
    "postcss": "^8.5.28",
    "react-email": "4.3.2",
    "rollup": "^4.63.5",
    "serialize-javascript": "^7.1.2",
    "sharp": "0.35.4",
    "socket.io-parser": "^4.2.7",
    "tar-fs": "^2.1.5",
    "ws": "^8.21.3"
  }
}
