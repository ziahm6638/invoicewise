# Every value comes from the process environment: self-hosted Infisical
# project `invoicewise`, environment `staging` (never production values).
# By hand, from the repo root: infisical run --env staging -- kamal <cmd> -d staging
# In CI, .github/workflows/deploy-staging.yml exports the same names.
DATABASE_PRIMARY_URL=$DATABASE_PRIMARY_URL
BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
SMTP_PASS=$SMTP_PASS
STORAGE_SIGNING_SECRET=$STORAGE_SIGNING_SECRET
MIDDAY_ENCRYPTION_KEY=$MIDDAY_ENCRYPTION_KEY
TYPESAFE_API_KEY=$TYPESAFE_API_KEY
OPS_TOKEN=$OPS_TOKEN
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
NANGO_SECRET_KEY=$NANGO_SECRET_KEY
NANGO_ENCRYPTION_KEY=$NANGO_ENCRYPTION_KEY
NANGO_DB_PASSWORD=$NANGO_DB_PASSWORD
NANGO_DASHBOARD_PASSWORD=$NANGO_DASHBOARD_PASSWORD
CLOUDFLARE_TUNNEL_TOKEN=$CLOUDFLARE_TUNNEL_TOKEN
