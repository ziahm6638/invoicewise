# Resend
RESEND_API_KEY=re_local_development
RESEND_AUDIENCE_ID=

# Better Auth (must match apps/dashboard/.env)
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=invoicewise-local-development-auth-secret-change-in-production
# Set to .invoicewise.uk when the dashboard and API use sibling subdomains.
BETTER_AUTH_COOKIE_DOMAIN=
AUTH_EMAIL_FROM="InvoiceWise <auth@invoicewise.uk>"

# Database
# Replica URLs are optional and intentionally unset for local development.
DATABASE_PRIMARY_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise

# Storage. Keep "local" for filesystem development, or use "s3" for MinIO/R2.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/invoicewise-storage
STORAGE_SIGNING_SECRET=local-development-storage-secret
STORAGE_PUBLIC_URL=http://localhost:3003
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=invoicewise
STORAGE_S3_ACCESS_KEY_ID=invoicewise
STORAGE_S3_SECRET_ACCESS_KEY=invoicewise-secret
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# TypeSafe invoice extraction and judgments
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Nango accounting delivery (required only when accounting connections are used)
NANGO_SECRET_KEY=
NANGO_BASE_URL=https://api.nango.dev
NANGO_XERO_INTEGRATION_ID=
NANGO_XERO_DRAFT_BILL_ACTION=create-draft-bill
NANGO_QUICKBOOKS_INTEGRATION_ID=
NANGO_QUICKBOOKS_DRAFT_BILL_ACTION=create-draft-bill

# Effect workflow runner (defaults shown)
WORKFLOW_CONCURRENCY=4
WORKFLOW_POLL_MS=1000
WORKFLOW_LEASE_MS=120000
WORKFLOW_RETRY_BASE_MS=5000
WORKFLOW_RETRY_MAX_MS=60000

# Config
ALLOWED_API_ORIGINS="http://localhost:3001"
LOG_LEVEL=debug
MIDDAY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Polar
POLAR_ACCESS_TOKEN=polar_local_development
POLAR_ENVIRONMENT=sandbox

# Environment
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Google
GOOGLE_GENERATIVE_AI_API_KEY=
