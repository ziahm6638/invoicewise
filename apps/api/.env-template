# Transactional mail (Purelymail over SMTP).
#
# Every transactional message (verification, invitation, reset, API-key and app
# notices, and the queued invitation and onboarding mail) is sent over SMTP
# from AUTH_EMAIL_FROM, which must be a Purelymail sender address. SMTP_HOST
# defaults to smtp.purelymail.com and SMTP_PORT to 465 (implicit TLS).
# Production refuses to start without SMTP_USER, SMTP_PASS and AUTH_EMAIL_FROM,
# and never writes a token-bearing link to a log or a file.
#
# Point AUTH_MAIL_SINK_PATH at a local file to read the real verification,
# invitation and reset links during development; nothing is sent. Without a
# sink or SMTP credentials, only the subject and recipient are logged.
# AUTH_MAIL_SINK_PATH=./.mail-sink.jsonl
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional Resend marketing audience (contact removal on account deletion).
# Not used for transactional mail; skipped unless both values are set.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Better Auth (must match apps/dashboard/.env)
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=invoicewise-local-development-auth-secret-change-in-production
# Set to .invoicewise.uk when the dashboard and API use sibling subdomains.
BETTER_AUTH_COOKIE_DOMAIN=
# Cookie name prefix (default better-auth). Staging sets its own so it never
# collides with production cookies on the shared parent domain.
BETTER_AUTH_COOKIE_PREFIX=
AUTH_EMAIL_FROM="InvoiceWise <auth@invoicewise.uk>"

# Database
# Replica URLs are optional and intentionally unset for local development.
DATABASE_PRIMARY_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise

# Storage. Keep "local" for filesystem development, or use "s3" for MinIO/R2.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/invoicewise-storage
STORAGE_SIGNING_SECRET=local-development-storage-secret
STORAGE_PUBLIC_URL=http://localhost:3003
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=invoicewise
STORAGE_S3_ACCESS_KEY_ID=invoicewise
STORAGE_S3_SECRET_ACCESS_KEY=invoicewise-secret
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# TypeSafe invoice extraction and judgments
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Self-hosted Nango for Xero/QuickBooks delivery (docs/accounting-integrations.md);
# required only when accounting connections are used. There is no default host.
NANGO_BASE_URL=
# Browser-facing Nango host for Connect UI (defaults to NANGO_BASE_URL)
NANGO_PUBLIC_URL=
NANGO_SECRET_KEY=
NANGO_XERO_INTEGRATION_ID=xero
NANGO_QUICKBOOKS_INTEGRATION_ID=quickbooks

# Effect workflow runner (defaults shown)
WORKFLOW_CONCURRENCY=4
WORKFLOW_POLL_MS=1000
WORKFLOW_LEASE_MS=120000
WORKFLOW_RETRY_BASE_MS=5000
WORKFLOW_RETRY_MAX_MS=60000
# How often the runner re-drives delivery intents whose job was lost or failed unrecorded
WORKFLOW_RECONCILE_MS=60000

# Config
ALLOWED_API_ORIGINS="http://localhost:3001"
LOG_LEVEL=debug
MIDDAY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Polar
POLAR_ACCESS_TOKEN=polar_local_development
POLAR_ENVIRONMENT=sandbox

# Environment
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Google
GOOGLE_GENERATIVE_AI_API_KEY=
