# Resend
RESEND_API_KEY=re_local_development
RESEND_AUDIENCE_ID=

# Supabase
SUPABASE_JWT_SECRET=local-development-jwt-secret
SUPABASE_SERVICE_KEY=local-development-service-key
SUPABASE_URL=http://localhost:54321

# Database
# Replica URLs are optional and intentionally unset for local development.
DATABASE_PRIMARY_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise
DATABASE_PRIMARY_POOLER_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise

# Used in drizzle-kit
DATABASE_SESSION_POOLER=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise

# Engine
ENGINE_API_URL=http://localhost:3002
ENGINE_API_KEY=local-development-engine-key

# LLMS
OPENAI_API_KEY=

# Config
ALLOWED_API_ORIGINS="http://localhost:3001"
LOG_LEVEL=debug
INVOICE_JWT_SECRET=local-development-invoice-secret
MIDDAY_ENCRYPTION_KEY=local-development-encryption-key
MIDDAY_DASHBOARD_URL="http://localhost:3001"

# Trigger
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# Polar
POLAR_ACCESS_TOKEN=polar_local_development
POLAR_ENVIRONMENT=sandbox

# Environment
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Google
GOOGLE_GENERATIVE_AI_API_KEY=
