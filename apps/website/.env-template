# --- Lead store: shared PocketBase, reached over REST (server only) ---
POCKETBASE_URL=https://leads.sortx.uk
# Service token, never exposed to the browser.
POCKETBASE_TOKEN=
# Required secret salt used before hashing visitor IP addresses. Without it the
# waitlist fails closed: submissions are rejected and no email is sent.
IP_HASH_SALT=

# --- Email: Purelymail SMTP via nodemailer (server only) ---
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InvoiceWise <hello@invoicewise.uk>"
MAIL_NOTIFY_TO=hello@invoicewise.uk

# --- Dedicated inbound mailbox copy ---
# "true" only after the receiving address is live (docs/inbound-email.md);
# until then the site keeps the "(coming soon)" wording.
INBOUND_EMAIL_LIVE=false
