NEXT_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3003

# Better Auth (must match apps/api/.env)
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=invoicewise-local-development-auth-secret-change-in-production
# Set to .invoicewise.uk when the dashboard and API use sibling subdomains.
BETTER_AUTH_COOKIE_DOMAIN=
# Cookie name prefix; must match apps/api/.env (staging sets its own).
BETTER_AUTH_COOKIE_PREFIX=
AUTH_EMAIL_FROM="InvoiceWise <auth@invoicewise.uk>"

# Database and storage (server routes only)
DATABASE_PRIMARY_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/invoicewise-storage
STORAGE_SIGNING_SECRET=local-development-storage-secret
STORAGE_PUBLIC_URL=http://localhost:3003
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=invoicewise
STORAGE_S3_ACCESS_KEY_ID=invoicewise
STORAGE_S3_SECRET_ACCESS_KEY=invoicewise-secret
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# Transactional mail over Purelymail SMTP (see apps/api/.env-template for the
# full policy). AUTH_EMAIL_FROM above is the sender. Production refuses to start
# without SMTP_USER, SMTP_PASS and AUTH_EMAIL_FROM; locally, AUTH_MAIL_SINK_PATH
# captures the mail instead of sending it.
# AUTH_MAIL_SINK_PATH=./.mail-sink.jsonl
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional Resend marketing audience; not used for transactional mail.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Github
GITHUB_TOKEN=

# Plain
PLAIN_API_KEY=

# OpenPanel
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=

# Webhook
WEBHOOK_SECRET_KEY=local-development-webhook-secret

# InvoiceWise Cache
MIDDAY_CACHE_API_SECRET=

# Polar
POLAR_ACCESS_TOKEN=polar_local_development
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
