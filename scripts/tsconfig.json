{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@db/*": ["../packages/db/src/*"],
      "@jobs/*": ["../packages/jobs/src/*"]
    }
  },
  "include": [
    "*.ts",
    "verify/**/*.ts",
    "deploy/**/*.ts",
    "ops/**/*.ts",
    "brand/**/*.ts",
    "../e2e/**/*.ts",
    "../types"
  ],
  "exclude": ["node_modules"]
}
