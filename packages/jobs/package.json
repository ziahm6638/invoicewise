{
  "name": "@invoicewise/jobs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "worker": "bun run src/worker.ts",
    "status": "bun run src/status.ts",
    "resume-deletions": "bun run src/resume-deletions.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "verify": "bun run src/verify-workflows.ts",
    "verify:accounting": "bun run src/verify-accounting.ts",
    "prove:accounting-sandbox": "bun run src/prove-accounting-sandbox.ts",
    "verify:handoff": "bun run src/verify-handoff.ts",
    "verify:exceptions": "bun run src/verify-exceptions.ts",
    "verify:suppliers": "bun run src/verify-suppliers.ts",
    "verify:authorization-sources": "bun run src/verify-authorization-sources.ts",
    "verify:questions": "bun run src/verify-questions.ts"
  },
  "exports": {
    ".": "./src/client.ts",
    "./intake": "./src/intake.ts",
    "./intake-failure": "./src/intake-failure.ts",
    "./inbound-email": "./src/inbound-email.ts",
    "./runner": "./src/runner.ts",
    "./schema": "./src/schema.ts",
    "./accounting": "./src/accounting.ts",
    "./activity": "./src/activity.ts",
    "./operator-recovery": "./src/operator-recovery.ts",
    "./suppliers": "./src/suppliers.ts",
    "./authorization-sources": "./src/authorization-sources.ts",
    "./questions": "./src/questions.ts",
    "./deletion": "./src/deletion.ts",
    "./delivery": "./src/delivery.ts",
    "./exceptions": "./src/exceptions.ts",
    "./webhooks": "./src/webhooks.ts",
    "./data-export": "./src/data-export.ts",
    "./retention": "./src/retention.ts",
    "./retention-policy": "./src/retention-policy.ts",
    "./zip": "./src/zip.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "^0.91.2",
    "@invoicewise/db": "workspace:*",
    "@invoicewise/documents": "workspace:*",
    "@invoicewise/email": "workspace:*",
    "@invoicewise/encryption": "workspace:*",
    "@invoicewise/inbox": "workspace:*",
    "@invoicewise/utils": "workspace:*",
    "effect": "^3.22.2",
    "nanoid": "^5.1.16",
    "postal-mime": "^3.0.0",
    "resend": "^4.6.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
