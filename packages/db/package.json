    "./queries/teams": "./src/queries/teams.ts",
    "./schema": "./src/schema.ts",
    "./storage": "./src/storage.ts",
    "./sql": "./src/sql.ts",
    "./utils/api-keys": "./src/utils/api-keys.ts",
    "./utils/search-query": "./src/utils/search-query.ts",
    "./utils/scopes": "./src/utils/scopes.ts",
    "./utils/redact": "./src/utils/redact.ts",
    "./utils/health": "./src/utils/health.ts",
    "./utils/currency": "./src/utils/currency.ts",
    "./utils/tax": "./src/utils/tax.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@date-fns/utc": "^2.1.1",
    "@invoicewise/categories": "workspace:*",
