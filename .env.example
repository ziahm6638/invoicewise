# Docker Compose
POSTGRES_DB=invoicewise
POSTGRES_USER=invoicewise
POSTGRES_PASSWORD=invoicewise
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=invoicewise
MINIO_ROOT_PASSWORD=invoicewise-secret

# Database tooling
# Local development deliberately configures only the primary database. Do not set
# DATABASE_FRA_URL, DATABASE_SJC_URL, or DATABASE_IAD_URL unless testing replicas.
DATABASE_PRIMARY_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise

# Storage. Keep "local" for filesystem development, or use "s3" for MinIO/R2.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/invoicewise-storage
STORAGE_SIGNING_SECRET=local-development-storage-secret
STORAGE_PUBLIC_URL=http://localhost:3003
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=invoicewise
STORAGE_S3_ACCESS_KEY_ID=invoicewise
STORAGE_S3_SECRET_ACCESS_KEY=invoicewise-secret
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# TypeSafe invoice extraction and judgments
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Self-hosted Nango for Xero/QuickBooks delivery (docs/accounting-integrations.md);
# required only when accounting connections are used. There is no default host.
NANGO_BASE_URL=
# Browser-facing Nango host for Connect UI (defaults to NANGO_BASE_URL)
NANGO_PUBLIC_URL=
NANGO_SECRET_KEY=
NANGO_XERO_INTEGRATION_ID=xero
NANGO_QUICKBOOKS_INTEGRATION_ID=quickbooks

# Effect workflow runner (defaults shown)
WORKFLOW_CONCURRENCY=4
WORKFLOW_POLL_MS=1000
WORKFLOW_LEASE_MS=120000
WORKFLOW_RETRY_BASE_MS=5000
WORKFLOW_RETRY_MAX_MS=60000
