# Docker Compose
POSTGRES_DB=invoicewise
POSTGRES_USER=invoicewise
POSTGRES_PASSWORD=invoicewise
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database tooling
# Local development deliberately configures only the primary database. Do not set
# DATABASE_FRA_URL, DATABASE_SJC_URL, or DATABASE_IAD_URL unless testing replicas.
DATABASE_PRIMARY_URL=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise
DATABASE_SESSION_POOLER=postgresql://invoicewise:invoicewise@localhost:5432/invoicewise
